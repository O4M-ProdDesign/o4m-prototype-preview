    <div style={{ width: 36, height: 36, borderRadius: 18, backgroundColor: C.bgCard, border: `1.5px solid ${C.border}`, display: 'flex', alignItems: 'center', justifyContent: 'center', flexShrink: 0 }}>
      <span className="material-symbols-rounded" style={{ fontSize: 20, color: C.textIcon, fontVariationSettings: "'FILL' 0, 'wght' 300" }}>{name}</span>
    </div>
  )
}

const typeLabel = { procedure: 'Procedure/Surgery', medication: 'Medication', scan: 'Scan/Lab', diagnosis: 'Diagnosis' }
const typeColor = { procedure: C.textSecondary, medication: C.textSecondary, scan: C.textSecondary, diagnosis: C.textSecondary }

// ─── PRIMITIVES ───────────────────────────────────────────────────
